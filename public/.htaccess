# ───────────────────────────────────────────────────────────
#  Little Pathshala — Hostinger (Apache / LiteSpeed) config
# ───────────────────────────────────────────────────────────

Options -Indexes
RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Force non-www  (canonical host: littlepathshala.com)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 3. Custom 404 page (client routes are prerendered, so unknown paths land here)
ErrorDocument 404 /404.html

# ── Compression ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── Caching ──
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html        "access plus 0 seconds"
  ExpiresByType text/css         "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml    "access plus 1 year"
  ExpiresByType image/jpeg       "access plus 1 year"
  ExpiresByType image/png        "access plus 1 year"
  ExpiresByType image/webp       "access plus 1 year"
  ExpiresByType font/woff2       "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets never change — cache hard
  <FilesMatch "\.(css|js|woff2|svg|jpe?g|png|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML should always revalidate so new deploys show immediately
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Light security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
